PORT=8091
NODE_ENV=production
JWT_SECRET=replace-with-very-strong-random-secret
TOKEN_TTL=8h
REQUIRE_SIGNED_REQUESTS=true
SIGNATURE_WINDOW_SECONDS=300
NONCE_TTL_SECONDS=600
ALLOWED_ORIGINS=https://your-cloudfront-domain.cloudfront.net

# Comma-separated keyId:secret pairs used to verify inbound HMAC signatures
SIGNING_KEYS=web-client-1:replace-me-strong-hmac-secret,control-room-1:replace-me-strong-hmac-secret

# Demo users JSON. Replace with real IAM/SSO integration in production.
RELAY_USERS_JSON={"citizen-app":{"password":"change-me","role":"citizen_app"},"ngo-console":{"password":"change-me","role":"ngo_dispatcher"},"police-console":{"password":"change-me","role":"police_dispatcher"},"gov-console":{"password":"change-me","role":"gov_control"},"admin":{"password":"change-me","role":"admin"}}

# Optional outbound connectors (leave blank to queue locally)
GOV_RELAY_URL=
GOV_RELAY_KEY_ID=
GOV_RELAY_SIGNING_SECRET=
NGO_RELAY_URL=
NGO_RELAY_KEY_ID=
NGO_RELAY_SIGNING_SECRET=
POLICE_RELAY_URL=
POLICE_RELAY_KEY_ID=
POLICE_RELAY_SIGNING_SECRET=
